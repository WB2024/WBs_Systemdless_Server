# ---- After deploying -------------------------------------------------------
# Test logrotate config: logrotate --debug /etc/logrotate.d/wbs-server
# Force a rotation now:  logrotate --force /etc/logrotate.d/wbs-server
# Check rotation status: cat /var/lib/logrotate/status | grep wbs
