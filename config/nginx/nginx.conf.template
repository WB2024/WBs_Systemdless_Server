# ============================================================
# config/nginx/nginx.conf.template
# This is a TEMPLATE. Do not deploy directly.
# Alternative to Caddy — use if Caddy is not suitable.
# Copy to /etc/nginx/nginx.conf and adapt before use.
# Replace all {{PLACEHOLDER}} tokens with real values.
# Repository: https://github.com/WB2024/WBs_Systemdless_Server
# ============================================================

# ---- Main nginx config -----------------------------------------------------
user www-data;
worker_processes auto;
pid /run/nginx.pid;

# Log to flat files — no journald dependency
error_log /var/log/nginx/error.log warn;

events {
    # Max simultaneous connections per worker
    # 1024 is conservative — increase for high-traffic environments
    worker_connections 1024;
    multi_accept on;
}

http {
    # ---- Basic settings ------------------------------------------------
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    server_tokens off;  # Don't expose nginx version in headers

    # ---- Logging -------------------------------------------------------
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # ---- TLS settings --------------------------------------------------
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- Security headers (applied globally) ---------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ---- Gzip compression ----------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    # ---- Rate limiting -------------------------------------------------
    # Limit requests from any single IP to reduce abuse risk
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/m;

    # ---- Upstream: FastAPI web UI --------------------------------------
    # TODO: DECISION REQUIRED — see Knowledge.md §17 Q1 (Cockpit vs FastAPI)
    upstream wbs_webui {
        server 127.0.0.1:8080;
        keepalive 4;
    }

    # ---- HTTP server: redirect to HTTPS --------------------------------
    server {
        listen 80;
        server_name {{SERVER_HOSTNAME}};
        # e.g.: server_name nas.yourdomain.com;
        # or for LAN: server_name _;

        # Redirect all HTTP to HTTPS
        return 301 https://$host$request_uri;
    }

    # ---- HTTPS server: reverse proxy to web UI -------------------------
    server {
        listen 443 ssl http2;
        server_name {{SERVER_HOSTNAME}};

        # TLS certificate paths (obtain via Let's Encrypt, Tailscale, or self-signed)
        ssl_certificate     {{TLS_CERT_PATH}};
        ssl_certificate_key {{TLS_KEY_PATH}};
        # e.g.:
        #   ssl_certificate     /etc/ssl/certs/nas.crt;
        #   ssl_certificate_key /etc/ssl/private/nas.key;

        # HSTS — only enable once TLS is confirmed working
        # add_header Strict-Transport-Security "max-age=31536000" always;

        # ---- Proxy to FastAPI web UI -----------------------------------
        location / {
            proxy_pass         http://wbs_webui;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection "upgrade";

            # Apply API rate limit
            limit_req zone=api_limit burst=10 nodelay;
        }

        # ---- Netdata (optional sub-path proxy) -------------------------
        # Uncomment to expose Netdata at /netdata/
        # location /netdata/ {
        #     proxy_pass http://127.0.0.1:19999/;
        #     proxy_http_version 1.1;
        #     proxy_set_header Host $host;
        #     proxy_set_header X-Real-IP $remote_addr;
        # }
    }
}

# ---- After editing ---------------------------------------------------------
# Validate config: nginx -t
# Reload nginx:    rc-service nginx reload
# Check logs:      tail -f /var/log/nginx/error.log
