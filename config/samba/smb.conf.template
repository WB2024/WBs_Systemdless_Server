# ============================================================
# config/samba/smb.conf.template
# This is a TEMPLATE. Do not deploy directly.
# Use scripts/03-install-samba.sh to deploy to /etc/samba/smb.conf
# Replace all {{PLACEHOLDER}} tokens with real values before use.
# Repository: https://github.com/WB2024/WBs_Systemdless_Server
# ============================================================

[global]
    # ---- Server identity ------------------------------------------------
    server string = {{SERVER_DESCRIPTION}}
    # e.g.: server string = WB's NAS Server

    netbios name = {{NETBIOS_NAME}}
    # e.g.: netbios name = WBNAS
    # Must be 15 chars or fewer, uppercase, no spaces

    workgroup = {{WORKGROUP}}
    # e.g.: workgroup = WORKGROUP (match your Windows/macOS workgroup)

    # ---- Security -------------------------------------------------------
    security = user
    # 'user' mode: each share requires a valid Samba username + password
    # Set passwords with: smbpasswd -a <username>

    # Do NOT use 'share' security — it allows unauthenticated access
    encrypt passwords = yes

    # Guest access disabled — all shares require authentication
    map to guest = never

    # ---- Logging --------------------------------------------------------
    # Logs to flat files — no systemd journal, no syslog drain
    log file = /var/log/samba/log.%m
    max log size = 1000
    log level = 1

    # ---- Performance ----------------------------------------------------
    # Disable printing — this is a NAS, not a print server
    load printers = no
    printing = bsd
    printcap name = /dev/null
    disable spoolss = yes

    # Async I/O — improves throughput on multi-disk pools
    aio read size = 1
    aio write size = 1

    # ---- Samba without logind -------------------------------------------
    # NOTE: This Samba instance runs WITHOUT logind (elogind not installed).
    # The following features will NOT work:
    #   - Automatic session tracking via PAM/logind
    #   - Windows ACL passthrough requiring logind
    #   - Kerberos delegation in some configurations
    # See docs/samba-without-logind.md for full impact assessment.
    # TODO: DECISION REQUIRED — test logind-free limitations on target HW

    # Explicitly disable features that require logind
    usershare allow guests = no

# ---- Share definitions --------------------------------------------------
# Each share section below follows the format:
#   [share_name] — the name visible on the network
#   path          — the local filesystem path being shared
#   valid users   — who can access this share (use @groupname for a group)
#   read only     — yes/no
#   browseable    — whether the share appears in network discovery

[media]
    comment = Media Library
    path = /srv/shares/media
    # Only users in the 'nasusers' group can access this share
    valid users = @nasusers
    read only = no
    browseable = yes
    create mask = 0664
    directory mask = 0775
    # Hosts allowed to connect (blank = all; restrict for security)
    hosts allow = {{ALLOWED_SUBNET}}
    # e.g.: hosts allow = 192.168.1.0/24 100.64.0.0/10
    # The 100.64.0.0/10 range covers Tailscale's CGNAT IP space

[backups]
    comment = Backup Storage
    path = /srv/shares/backups
    valid users = @nasusers
    read only = no
    browseable = yes
    create mask = 0660
    directory mask = 0770
    hosts allow = {{ALLOWED_SUBNET}}

# ---- Template instructions ----------------------------------------------
# After editing this file:
#   1. Validate with: testparm
#   2. Restart Samba:  rc-service smbd restart && rc-service nmbd restart
#   3. Set user passwords: smbpasswd -a <username>
#   4. Create share directories:
#        mkdir -p /srv/shares/media /srv/shares/backups
#        chown root:nasusers /srv/shares/{media,backups}
#        chmod 0775 /srv/shares/{media,backups}
