# WB's Systemdless Server — Web UI environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit .env with real secrets.
# All variables here must be set before starting the web UI.

# ---- Server settings -------------------------------------------------------

# Host and port for uvicorn (production)
# In production, bind to 127.0.0.1 only — use Caddy/nginx as reverse proxy
WBS_HOST=127.0.0.1
WBS_PORT=8080

# Number of uvicorn workers (1 for single-core NAS, increase if needed)
WBS_WORKERS=1

# ---- Security --------------------------------------------------------------

# Secret key for signing session tokens / CSRF protection
# Generate a secure key with: python3 -c "import secrets; print(secrets.token_hex(32))"
WBS_SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# ---- Application settings --------------------------------------------------

# Debug mode — set to false in production
WBS_DEBUG=false

# Application title shown in the web UI
WBS_APP_TITLE=WB's Systemdless Server

# ---- Storage paths ---------------------------------------------------------

# Root of the mergerfs pool (must match /etc/fstab)
WBS_POOL_PATH=/srv/pool

# Root of Samba shares
WBS_SHARES_PATH=/srv/shares

# ---- Logging ---------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
WBS_LOG_LEVEL=INFO
